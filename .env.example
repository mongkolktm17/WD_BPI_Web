# System Environment Configuration

# Application
NODE_ENV=production
PORT=4000

# Next.js Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-random-secret-in-production
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_INTERNAL_URL=http://api:4000

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://wdbpi_user:wdbpi_pass@postgres:5432/wdbpi_db?schema=public

# Redis (Redis 8)
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=change-this-to-random-secret-in-production
CORS_ORIGIN=http://localhost:3000

# Production-only
POSTGRES_PASSWORD=change-this-in-production
REDIS_PASSWORD=change-this-in-production

# ============================================================
# Legacy System (PHP + MySQL)
# ============================================================
MYSQL_ROOT_PASSWORD=change-this-in-production
MYSQL_DATABASE=wdbpi_legacy
MYSQL_USER=wdbpi_legacy
MYSQL_PASSWORD=change-this-in-production
