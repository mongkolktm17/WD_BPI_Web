{
  "name": "wdbpi-monorepo",
  "version": "2.3.0",
  "packageManager": "npm@11.17.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "migrate:data": "ts-node scripts/migrate-data.ts"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0",
    "prettier": "^3.5.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.0",
    "typescript": "^5.8.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "pg": "^8.22.0"
  }
}
