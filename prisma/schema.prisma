  reportId       Int @map("report_id")
  nvrId          Int @map("nvr_id")
  onlineChannels Int @map("online_channels")

  @@map("nvr_status_report_details")
}

// 33. Legacy CCTV Angle Reports Table
model CctvAngleReport {
  id               Int       @id @default(autoincrement())
  reportDate       DateTime  @map("report_date") @db.Date
  building         String    @db.VarChar(255)
  nvr              Int       @map("nvr")
  totalCameras     Int       @map("total_cameras")
  correctCameras   Int       @map("correct_cameras")
  incorrectCameras Int       @map("incorrect_cameras")
  checkedBy        String    @map("checked_by") @db.VarChar(255)
  updatedBy        String?   @map("updated_by") @db.VarChar(100)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cctv_angle_reports")
}

// 34. Legacy CCTV Report Details Table
model CctvReportDetail {
  id                  Int     @id @default(autoincrement())
  reportId            Int     @map("report_id")
  nvrName             String  @map("nvr_name") @db.VarChar(255)
  onlineChannels      Int     @map("online_channels")
  totalChannels       Int     @default(0) @map("total_channels")
  channelStatusesJson String? @map("channel_statuses_json") @db.Text

  @@map("cctv_report_details")
}

// 35. Legacy Patrol Checks Table
model PatrolCheckLegacy {
  id             Int      @id @default(autoincrement())
  inspectionDate DateTime @map("inspection_date") @db.Date
  patrolStatus   String   @map("patrol_status") @db.VarChar(255)
  shift          String   @db.VarChar(50)
  employeeId     String   @map("employee_id") @db.VarChar(255)
  inspectorName  String   @map("inspector_name") @db.VarChar(255)
  patrolTime     String   @map("patrol_time") @db.VarChar(50)
  building       String   @db.VarChar(255)
  submittedById  Int?     @map("submitted_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("patrol_checks")
}
