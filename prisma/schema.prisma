datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Roles Table
model Role {
  id          Int              @id @default(autoincrement())
  roleName    String           @map("role_name") @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// 2. Role Permissions Table
model RolePermission {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  moduleName String   @map("module_name") @db.VarChar(50)
  canRead    Boolean  @default(false) @map("can_read")
  canWrite   Boolean  @default(false) @map("can_write")
  canDelete  Boolean  @default(false) @map("can_delete")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_permissions")
}

// 3. Users Table
model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(50)
  password   String     @db.VarChar(255)
  fullName   String     @map("full_name") @db.VarChar(100)
  employeeId String?    @unique @map("employee_id") @db.VarChar(8)
  roleId     Int        @map("role_id")
  department String?    @db.VarChar(100)
  phone      String?    @db.VarChar(20)
  email      String?    @db.VarChar(100)
  isActive   Boolean    @default(true) @map("is_active")
  lastLogin  DateTime?  @map("last_login") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role       Role       @relation(fields: [roleId], references: [id])
  auditLogs  AuditLog[]

  @@map("users")
}

// 4. Officers Table
model Officer {
  id           Int      @id @default(autoincrement())
  employeeId   String   @unique @map("employee_id") @db.VarChar(20)
  titleName    String?  @map("title_name") @db.VarChar(20)
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  position     String?  @db.VarChar(100)
  company      String?  @db.VarChar(100)
  siteLocation String?  @map("site_location") @db.VarChar(100)
  shift        String?  @db.VarChar(20)
  status       String   @default("active") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("officers")
}

// 5. Buildings Table
model Building {
  id           Int         @id @default(autoincrement())
  buildingCode String      @unique @map("building_code") @db.VarChar(20)
  buildingName String      @map("building_name") @db.VarChar(100)
  description  String?     @db.Text
  cameras      Camera[]
  nvrDevices   NvrDevice[]

  @@map("buildings")
}

// 6. Cameras Table
model Camera {
  id         Int           @id @default(autoincrement())
  buildingId Int           @map("building_id")
  cameraNo   String        @map("camera_no") @db.VarChar(20)
  cameraName String        @map("camera_name") @db.VarChar(100)
  location   String?       @db.VarChar(200)
  status     String        @default("normal") @db.VarChar(20)
  building   Building      @relation(fields: [buildingId], references: [id])
  checks     CameraCheck[]

  @@map("cameras")
}

// 7. Camera Checks Table
model CameraCheck {
  id        Int       @id @default(autoincrement())
  cameraId  Int       @map("camera_id")
  checkDate DateTime  @map("check_date") @db.Date
  status    String    @db.VarChar(20)
  remark    String?   @db.Text
  checkedBy String?   @map("checked_by") @db.VarChar(50)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy String?   @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  camera    Camera    @relation(fields: [cameraId], references: [id])

  @@map("camera_checks")
}

// 8. NVR Devices Table
model NvrDevice {
  id            Int               @id @default(autoincrement())
  buildingId    Int               @map("building_id")
  nvrName       String            @map("nvr_name") @db.VarChar(100)
  ipAddress     String?           @map("ip_address") @db.VarChar(45)
  totalChannels Int               @default(16) @map("total_channels")
  building      Building          @relation(fields: [buildingId], references: [id])
  recordings    NvrRecordingDay[]

  @@map("nvr_devices")
}

// 9. NVR Recording Days Table
model NvrRecordingDay {
  id           Int       @id @default(autoincrement())
  nvrId        Int       @map("nvr_id")
  recordDate   DateTime  @map("record_date") @db.Date
  daysRecorded Int       @map("days_recorded")
  status       String    @db.VarChar(20)
  remark       String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  nvr          NvrDevice @relation(fields: [nvrId], references: [id])

  @@map("nvr_recording_days")
}

// 10. CCTV Reports Table
model CctvReport {
  id            Int       @id @default(autoincrement())
  reportDate    DateTime  @map("report_date") @db.Date
  totalNormal   Int       @default(0) @map("total_normal")
  totalAbnormal Int       @default(0) @map("total_abnormal")
  reporterName  String    @map("reporter_name") @db.VarChar(100)
  remark        String?   @db.Text
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedBy     String?   @map("deleted_by")
  deletedAt     DateTime? @map("deleted_at")
  updatedBy     String?   @map("updated_by") @db.VarChar(100)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  submittedById Int?      @map("submitted_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cctv_reports")
}

// 11. Car Parkings Table
model CarParking {
  id                   Int       @id @default(autoincrement())
  recordDate           DateTime  @map("record_date") @db.Date
  slotNo               String    @map("slot_no") @db.VarChar(20)
  carLicense           String    @map("car_license") @db.VarChar(50)
  driverName           String?   @map("driver_name") @db.VarChar(100)
  timeIn               DateTime? @map("time_in") @db.Timestamptz(6)
  timeOut              DateTime? @map("time_out") @db.Timestamptz(6)
  status               String    @default("parked") @db.VarChar(20)
  lotCounts            Json?     @map("lot_counts")
  totalCars            Int?      @default(0) @map("total_cars")
  inspectorCode        String?   @map("inspector_code") @db.VarChar(20)
  inspectorName        String?   @map("inspector_name") @db.VarChar(100)
  shift                String?   @map("shift") @db.VarChar(20)
  parkingLot           String?   @map("parking_lot") @db.VarChar(100)
  spareTireStatus      String?   @map("spare_tire_status") @db.VarChar(50)
  licensePlates        String?   @map("license_plates") @db.Text
  motorcycleParkingLot String?   @map("motorcycle_parking_lot") @db.VarChar(100)
  motorcycleCount1     Int?      @default(0) @map("motorcycle_count_1")
  motorcycleCount2     Int?      @default(0) @map("motorcycle_count_2")
  motorcycleCount3     Int?      @default(0) @map("motorcycle_count_3")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedBy            String?   @map("deleted_by")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("car_parkings")
}

// 12. Guard Duty Logs Table
model GuardDutyLog {
  id        Int      @id @default(autoincrement())
  logDate   DateTime @map("log_date") @db.Date
  shift     String   @db.VarChar(20)
  guardName String   @map("guard_name") @db.VarChar(100)
  dutyPost  String   @map("duty_post") @db.VarChar(100)
  eventLog  String   @map("event_log") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("guard_duty_logs")
}

// 13. Handheld Equipment Table
model HandheldEquipment {
  id         Int             @id @default(autoincrement())
  deviceCode String          @unique @map("device_code") @db.VarChar(50)
  deviceName String          @map("device_name") @db.VarChar(100)
  status     String          @default("normal") @db.VarChar(20)
  location   String?         @db.VarChar(100)
  checks     HandheldCheck[]

  @@map("handheld_equipment")
}

// 14. Handheld Checks Table
model HandheldCheck {
  id          Int               @id @default(autoincrement())
  equipmentId Int               @map("equipment_id")
  checkDate   DateTime          @map("check_date") @db.Date
  status      String            @db.VarChar(20)
  remark      String?           @db.Text
  inspector   String?           @db.VarChar(100)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  deletedBy   String?           @map("deleted_by")
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  equipment   HandheldEquipment @relation(fields: [equipmentId], references: [id])

  @@map("handheld_checks")
}

// 15. Walkthrough Detectors Table
model WalkthroughDetector {
  id           Int                @id @default(autoincrement())
  detectorCode String             @unique @map("detector_code") @db.VarChar(50)
  location     String             @db.VarChar(100)
  status       String             @default("normal") @db.VarChar(20)
  checks       WalkthroughCheck[]

  @@map("walkthrough_detectors")
}

// 16. Walkthrough Checks Table
model WalkthroughCheck {
  id         Int                 @id @default(autoincrement())
  detectorId Int                 @map("detector_id")
  checkDate  DateTime            @map("check_date") @db.Date
  status     String              @db.VarChar(20)
  remark     String?             @db.Text
  inspector  String?             @db.VarChar(100)
  isDeleted  Boolean             @default(false) @map("is_deleted")
  deletedBy  String?             @map("deleted_by")
  deletedAt  DateTime?           @map("deleted_at")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  detector   WalkthroughDetector @relation(fields: [detectorId], references: [id])

  @@map("walkthrough_checks")
}

// 17. Metal Detectors Table
model MetalDetector {
  id         Int       @id @default(autoincrement())
  deviceCode String    @unique @map("device_code") @db.VarChar(50)
  location   String    @db.VarChar(100)
  status     String    @default("normal") @db.VarChar(20)
  lastCheck  DateTime? @map("last_check") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("metal_detectors")
}

// 18. CCTV Inspections Table
model CctvInspection {
  id             Int       @id @default(autoincrement())
  inspectionDate DateTime  @map("inspection_date") @db.Date
  inspectorName  String    @map("inspector_name") @db.VarChar(100)
  totalChecked   Int       @map("total_checked")
  totalPassed    Int       @map("total_passed")
  totalFailed    Int       @map("total_failed")
  summary        String?   @db.Text
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedBy      String?   @map("deleted_by")
  deletedAt      DateTime? @map("deleted_at")
  updatedBy      String?   @map("updated_by") @db.VarChar(100)
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(6)
  submittedById  Int?      @map("submitted_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cctv_inspections")
}

// 19. Guard Counts Table
model GuardCount {
  id            Int       @id @default(autoincrement())
  recordDate    DateTime  @map("record_date") @db.Date
  shift         String    @db.VarChar(20)
  totalGuards   Int       @map("total_guards")
  presentGuards Int       @map("present_guards")
  absentGuards  Int       @map("absent_guards")
  remark        String?   @db.Text
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedBy     String?   @map("deleted_by")
  deletedAt     DateTime? @map("deleted_at")
  updatedBy     String?   @map("updated_by") @db.VarChar(100)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  submittedById Int?      @map("submitted_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("guard_counts")
}

// 20. Patrol Reports Table
model PatrolReport {
  id          Int       @id @default(autoincrement())
  patrolDate  DateTime  @map("patrol_date") @db.Date
  patrolRoute String    @map("patrol_route") @db.VarChar(100)
  officerName String    @map("officer_name") @db.VarChar(100)
  status      String    @db.VarChar(20)
  notes       String?   @db.Text
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedBy   String?   @map("deleted_by")
  deletedAt   DateTime? @map("deleted_at")
  updatedBy   String?   @map("updated_by") @db.VarChar(100)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("patrol_reports")
}

// 21. System Configs Table
model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_configs")
}

// 22. Audit Logs Table
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  details   String?  @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// 23. Report Visuals Table
model ReportVisual {
  id         Int      @id @default(autoincrement())
  reportType String   @map("report_type") @db.VarChar(50)
  title      String   @db.VarChar(200)
  dataJson   Json     @map("data_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("report_visuals")
}

// 24. Building Daily Reports Table
model BuildingReport {
  id                Int       @id @default(autoincrement())
  reportDate        DateTime  @map("report_date") @db.Date
  employeeId        String    @map("employee_id") @db.VarChar(8)
  fullName          String    @map("full_name") @db.VarChar(200)
  shift             String    @db.VarChar(10)
  building          String    @db.VarChar(10)
  guardPost         String    @map("guard_post") @db.VarChar(100)
  reportTime        String    @map("report_time") @db.VarChar(5)
  incidentReport    String    @map("incident_report") @db.Text
  specialIncident   String?   @map("special_incident") @db.Text
  emergencyIncident String?   @map("emergency_incident") @db.Text
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedBy         String?   @map("deleted_by")
  deletedAt         DateTime? @map("deleted_at")
  updatedBy         String?   @map("updated_by") @db.VarChar(100)
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("building_reports")
}

