  inspectionDate       DateTime  @map("inspection_date") @db.Date
  inspectorCode        String    @map("inspector_code") @db.VarChar(255)
  inspectorName        String    @map("inspector_name") @db.VarChar(255)
  shift                String    @db.VarChar(50)
  parkingLot           String    @map("parking_lot") @db.VarChar(255)
  totalCars            Int       @default(0) @map("total_cars")
  spareTireStatus      String    @map("spare_tire_status") @db.VarChar(50)
  licensePlates        String?   @map("license_plates") @db.Text
  motorcycleParkingLot String?   @map("motorcycle_parking_lot") @db.VarChar(255)
  motorcycleCount1     Int?      @map("motorcycle_count_1")
  motorcycleCount2     Int?      @map("motorcycle_count_2")
  motorcycleCount3     Int?      @map("motorcycle_count_3")
  updatedBy            String?   @map("updated_by") @db.VarChar(100)
  updatedAt            DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("car_parking_reports")
}

// 26. Legacy Parking Lot Counts Table
model ParkingLotCount {
  id           Int      @id @default(autoincrement())
  reportId     Int      @map("report_id")
  lotName      String   @map("lot_name") @db.VarChar(255)
  vehicleType  String   @map("vehicle_type") @db.VarChar(10)
  vehicleCount Int?     @map("vehicle_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("parking_lot_counts")
}

// 27. Legacy Hand Held Checks Table
model HandHeldCheckLegacy {
  id                  Int       @id @default(autoincrement())
  inspectionDate      DateTime  @map("inspection_date") @db.Date
  building            String    @db.VarChar(255)
