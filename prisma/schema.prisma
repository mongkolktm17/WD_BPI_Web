  shift               String    @db.VarChar(50)
  batteryStatus       String    @map("battery_status") @db.VarChar(255)
  ledStatus           String    @map("led_status") @db.VarChar(255)
  detectionTestStatus String    @map("detection_test_status") @db.VarChar(255)
  alarmStatus         String    @map("alarm_status") @db.VarChar(255)
  remarks             String?   @db.Text
  updatedBy           String?   @map("updated_by") @db.VarChar(100)
  updatedAt           DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hand_held_checks")
}

