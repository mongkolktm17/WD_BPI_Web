// 29. Legacy NVR Recording Reports Table
model NvrRecordingReport {
  id            Int      @id @default(autoincrement())
  building      String   @db.VarChar(10)
  submissionId  String?  @map("submission_id") @db.VarChar(50)
  submittedById Int      @map("submitted_by_id")
